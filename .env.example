# ---------------------------------------------------------------------------
# API keys (providers)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=          # used by the OFFLINE pipeline (src/clients) only
GROQ_API_KEY=            # used by the live gateway + offline pipeline
OLLAMA_API_KEY=          # used by the live gateway (Ollama Cloud) + offline pipeline

# Ollama Cloud endpoint used by the LIVE gateway (gateway/llm_provider.py).
OLLAMA_API_URL=https://ollama.com/api
# Local Ollama URL used by the OFFLINE client (src/clients/ollama_client.py via configs/models.yaml).
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Gateway request DB (Postgres) — where each live request is logged
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=llm_logs
DB_USER=postgres
DB_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Semantic cache (Redis exact-match + Milvus similarity)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=86400
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=semantic_cache
MILVUS_CACHE_TTL_SECONDS=604800
EMBEDDING_DIM=384
# Cosine/IP similarity in [0,1]; a match must score >= this to be a cache hit.
CACHE_SIMILARITY_THRESHOLD=0.95

# ---------------------------------------------------------------------------
# Failover / routing (live gateway)
# ---------------------------------------------------------------------------
# Per-provider HTTP timeout (seconds) before failover kicks in.
PROVIDER_TIMEOUT_SECONDS=60
# "roundrobin" (default) or "smart" (uses the trained k-NN router if available).
GATEWAY_ROUTING_MODE=roundrobin
SMART_ROUTER_QUALITY_THRESHOLD=6.5
MODEL_EMBEDDINGS_PATH=outputs/trained_models/model_embeddings.csv
PROMPT_ENCODER_PATH=outputs/trained_models/prompt_encoder.pt

# ---------------------------------------------------------------------------
# Provider health (in-memory, per-process; deprioritises failing providers)
# ---------------------------------------------------------------------------
# Consecutive failures before a provider is marked unhealthy.
PROVIDER_UNHEALTHY_AFTER_FAILURES=3
# Seconds after the last failure before a probe is allowed again.
PROVIDER_HEALTH_RECOVERY_SECONDS=30

# ---------------------------------------------------------------------------
# Hardware profiling (estimate used only when no real GPU power telemetry)
# ---------------------------------------------------------------------------
# Master switch. When false, the gateway samples nothing (zero overhead);
# /hardware + /metrics still respond.
HARDWARE_PROFILING_ENABLED=true
# Attempt GPU (NVML) sampling. Independent of the master switch.
HARDWARE_GPU_ENABLED=true
ESTIMATED_HOST_ACTIVE_WATTS=65

# ---------------------------------------------------------------------------
# Offline registry database
# ---------------------------------------------------------------------------
REGISTRY_DB_PATH=outputs/registry/model_registry.sqlite
